// Generated by Gemini (free web version) from ONE prompt with the assignment PDF attached. Kept only for the AI tool comparison – not my hand-in model.
model SavannahDemographics

global {
    int nb_lions_init <- 10;
    int nb_zebras_init <- 20;
    
    // Requirement 1: Declare a list of age values
    list<int> lion_ages <- [];
    
    init {
        create zebras number: nb_zebras_init;
        create lions number: nb_lions_init {
            age <- rnd(1, 59);
        }
        
        // Requirement 2: Initialisation - add the age of all lions to the list
        ask lions {
            add self.age to: myself.lion_ages;
        }
    }
    
    // Requirement 3: Each time step, report size, min, mean, and max of the list
    reflex report_demographics {
        if (!empty(lion_ages)) {
            write "Lions Count: " + length(lion_ages) +
                  " | Min Age: " + min(lion_ages) +
                  " | Mean Age: " + mean(lion_ages) +
                  " | Max Age: " + max(lion_ages);
        }
    }
}

grid grass_grid width: 25 height: 25 {
    rgb color <- #green;
}

species zebras skills: [moving] {
    rgb color <- #black;
    
    reflex move {
        do wander;
    }
    
    aspect default {
        draw circle(1) color: color;
    }
}

species lions skills: [moving] {
    int age <- 0;
    
    reflex age_and_update_list {
        // Requirement 2: Remove previous age value
        remove age from: lion_ages;
        
        // Increment age
        age <- age + 1;
        
        // Requirement 2: Add current age value
        add age to: lion_ages;
        
        // Requirement 5 & 6: Die if older than 60, reproduce just before dying
        if (age > 60) {
            // Requirement 6: Just before an old lion dies, a baby lion is born
            create lions number: 1 {
                age <- 0;
                add self.age to: lion_ages;
            }
            
            // Requirement 5: Lions die if older than 60
            remove age from: lion_ages;
            do die;
        }
    }

    reflex move_and_hunt {
        do wander;
        zebras target <- zebras closest_to self;
        if (target != nil and self distance_to target <= 3.0) {
            ask target { do die; }
        }
    }
    
    aspect default {
        // Requirement 4: Update colour in shades of red according to mean age of population
        float avg_age <- empty(lion_ages) ? 1.0 : mean(lion_ages);
        int red_intensity <- int(255 * (age / (avg_age * 2.0)));
        rgb dynamic_red <- rgb(min([255, max([50, red_intensity])]), 0, 0);
        
        draw circle(1.5) color: dynamic_red;
    }
}

experiment Savannah type: gui {
    output {
        display main_display {
            grid grass_grid border: #gray;
            species zebras aspect: default;
            species lions aspect: default;
        }
    }
}